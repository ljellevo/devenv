{
  "name": "devenv-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "One place to start, stop, and switch local projects",
  "author": "Devenv",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "desktopName": "devenv.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "postinstall": "node scripts/ensure-electron.mjs",
    "test:system": "node scripts/test-system.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:companion": "node scripts/build-companion.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@playwright/test": "^1.55.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "dev.devenv.desktop",
    "npmRebuild": false,
    "productName": "Devenv",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/companion*/**",
      "!dist/companion*.tar.gz",
      "!dist/native/*.obj"
    ],
    "asarUnpack": [
      "**/node-pty/**",
      "dist/native/**"
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Devenv opens service logs and project folders in your terminal app."
      },
      "identity": null
    },
    "afterPack": "./scripts/afterPack.cjs",
    "publish": null,
    "dmg": {
      "title": "${productName} ${arch}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "extraResources": [
        {
          "from": "dist/companion-linux-x64.tar.gz",
          "to": "companion-linux-x64.tar.gz"
        }
      ]
    },
    "linux": {
      "executableName": "devenv",
      "syncDesktopName": true,
      "maintainer": "Devenv <ljellevo@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ljellevo/devenv.git"
  }
}
